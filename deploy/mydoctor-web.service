[Unit]
Description=Мой Доктор — веб-версия и API (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/my_doctor_bot
# Те же секреты, что и у бота: BOT_TOKEN, GROQ_API_KEY, API_JWT_SECRET, SMTP_* ...
EnvironmentFile=/opt/my_doctor_bot/.env
# Нас проксирует Caddy и перезаписывает X-Forwarded-For — тогда лимиты по IP считаются по реальному клиенту.
Environment=TRUST_PROXY_HEADERS=true
# Укажите тот же интерпретатор, что в юните бота (mydoctor.service), если venv лежит в другом месте.
ExecStart=/opt/my_doctor_bot/venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8000
# Один процесс: блокировка консультаций и лимиты по IP живут в памяти процесса.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
